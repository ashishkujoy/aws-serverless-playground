{
  "name": "insurance-integration-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Integration test harness for the insurance SAM application, built and deployed to floci via samlocal",
  "scripts": {
    "build:local": "sam build",
    "deploy:local": "samlocal deploy --config-env floci --resolve-s3 --no-confirm-changeset",
    "destroy:local": "samlocal delete --stack-name my-app-local --no-prompts",
    "test:integration": "jest --config jest.integration.config.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.1094.0",
    "@aws-sdk/lib-dynamodb": "^3.1094.0",
    "@jest/globals": "^29.2.0",
    "@types/jest": "^29.2.0",
    "@types/node": "^20.5.7",
    "jest": "^29.2.1",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "^4.8.4"
  }
}
